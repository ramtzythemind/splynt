NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sorgente degli orari: dataset | aerodatabox | opensky
FLIGHT_PROVIDER=dataset

# AeroDataBox (RapidAPI) — 600 unita/mese sul piano gratuito
# AERODATABOX_API_KEY=

# OpenSky Network — gratuito, OAuth2 client credentials
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# Protegge /api/cron/* (impostato automaticamente su Vercel)
# CRON_SECRET=
