# NB: same syntax as .gitignore — a pattern without a leading slash matches at
# ANY depth. Bare `supabase` would also exclude src/lib/supabase, and bare
# `acars` would exclude src/app/api/acars. Every entry here must stay anchored.

# The ACARS client runs on the pilot's simulator PC, not on Vercel.
/acars

# Migrations are applied from a workstation, not by the deployment.
/supabase

# One-off data scripts (seed, import, validation).
/scripts
